      "key": "󰏗 PACKAGES"
    },
    "break",
    {
      "type": "de",
      "key": "󱈹 DESKTOP"
    },
    {
      "type": "terminal",
      "key": " TERM"
    },
    {
      "type": "shell",
      "key": "󰈺 SHELL"
    },
    "break",
    {
